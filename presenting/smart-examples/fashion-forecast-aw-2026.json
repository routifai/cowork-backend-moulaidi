  "slides": [
    "<section class=\"relative h-[720px] w-[1280px] overflow-hidden bg-[#F4F3EF] flex flex-col justify-between p-16 select-none\" data-slide-title=\"Cover\" data-slide-type=\"title\">\n<!-- Subtle Grid Overlay to mimic premium print paper -->\n<div class=\"absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:100px_100px] pointer-events-none\"></div>\n\n<!-- Header metadata -->\n<div class=\"flex justify-between items-start z-10\">\n<div class=\"text-[10px] tracking-[0.4em] uppercase text-[#111111] font-medium\" style=\"font-family: 'Montserrat', sans-serif;\">\n      ISSUE NO. 14 / METROPOLIS\n    </div>\n<div class=\"text-[10px] tracking-[0.4em] uppercase text-[#111111] font-medium text-right\" style=\"font-family: 'Montserrat', sans-serif;\">\n      PREDICTION REPORT\n    </div>\n</div>\n\n<!-- Main Editorial Title - Centered focus after image removal -->\n<div class=\"my-auto z-10 flex flex-col items-center text-center\">\n<h1 class=\"text-[110px] leading-[0.9] font-light text-[#111111] tracking-tighter\" style=\"font-family: 'Cormorant Garamond', serif;\">\n      FASHION FORECAST<br/>\n<span class=\"italic font-normal text-[#4A0E17] text-[80px]\">AUTUMN / WINTER 2026</span>\n</h1>\n<p class=\"mt-12 text-xs tracking-[0.4em] uppercase text-neutral-500 max-w-xl leading-relaxed\" style=\"font-family: 'Montserrat', sans-serif;\">\n      An analytical dissection of form, texture, and silence.<br/>Architectural silhouettes meet raw human materiality.\n    </p>\n</div>\n\n<!-- Footer metadata -->\n<div class=\"flex justify-between items-end z-10 border-t border-black/10 pt-4\">\n<span class=\"text-[10px] tracking-[0.35em] text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">© AW26 ARCHIVE</span>\n<span class=\"text-[10px] tracking-[0.35em] text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">01 — 10</span>\n</div>\n</section>",
    "<section class=\"relative h-[720px] w-[1280px] overflow-hidden bg-[#F4F3EF] flex flex-col justify-between p-16\" data-slide-title=\"Creative Direction\" data-slide-type=\"content\">\n<div class=\"absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:100px_100px] pointer-events-none\"></div>\n<!-- Top Navigation -->\n<div class=\"flex justify-between border-b border-black/10 pb-4\">\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-[#111111]\" style=\"font-family: 'Montserrat', sans-serif;\">01 / CONCEPTUAL DIRECTORY</span>\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">AW 2026 DIRECTIVE</span>\n</div>\n<!-- Main Split Layout -->\n<div class=\"grid grid-cols-12 gap-8 my-auto items-center\">\n<!-- Left Column: Manifesto -->\n<div class=\"col-span-7 flex flex-col justify-center pr-12\">\n<h2 class=\"text-xs tracking-[0.4em] uppercase text-[#4A0E17] font-semibold mb-6\" style=\"font-family: 'Montserrat', sans-serif;\">\n        THE SILENT SHIFT\n      </h2>\n<p class=\"text-4xl font-light text-[#111111] leading-tight tracking-tight mb-8\" style=\"font-family: 'Cormorant Garamond', serif;\">\n        As the digital landscape fractures, fashion recedes into the physical world. We observe a violent pivot toward absolute reductionism, heavy materials, and protective armor.\n      </p>\n<!-- Key Editorial Pillars -->\n<div class=\"grid grid-cols-2 gap-8 pt-8 border-t border-black/10\">\n<div>\n<h4 class=\"text-[10px] tracking-[0.2em] uppercase font-bold text-[#111111] mb-2\" style=\"font-family: 'Montserrat', sans-serif;\">I. ARCHITECTURAL RIGOR</h4>\n<p class=\"text-xs text-neutral-600 leading-relaxed\" style=\"font-family: 'Montserrat', sans-serif;\">\n            Garments treated as permanent structures rather than fleeting garments.\n          </p>\n</div>\n<div>\n<h4 class=\"text-[10px] tracking-[0.2em] uppercase font-bold text-[#111111] mb-2\" style=\"font-family: 'Montserrat', sans-serif;\">II. EMBODIED HUMANISM</h4>\n<p class=\"text-xs text-neutral-600 leading-relaxed\" style=\"font-family: 'Montserrat', sans-serif;\">\n            Design prioritized for tactile sensation and sensory protection.\n          </p>\n</div>\n</div>\n</div>\n<!-- Right Column: Dramatic Image -->\n<div class=\"col-span-5 relative\">\n<div class=\"h-[420px] w-full overflow-hidden grayscale contrast-125 border border-black/10\">\n<img alt=\"Textured structural gray felt\" class=\"w-full h-full object-cover\" image-type=\"image\" prompt=\"High-fashion editorial photo, extreme macro crop, textured heavy gray wool felt fabric, sharp structural fold, minimal studio background\" src=\"https://presenton-public-eu.s3.eu-central-1.amazonaws.com/users/6958c0f1-63bd-4057-bf63-4421d4951284/images/42e4dba1-9819-4103-a370-26d54963ff6f.png\"/>\n</div>\n<div class=\"absolute -bottom-8 -left-4 text-[9px] tracking-[0.3em] uppercase text-neutral-500\" style=\"font-family: 'Montserrat', sans-serif;\">\n        MATERIAL DEVIATION / NO. 892\n      </div>\n</div>\n</div>\n<!-- Bottom Page Number -->\n<div class=\"flex justify-between text-[10px] tracking-[0.35em] text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">\n<span>CREATIVE DIRECTION</span>\n<span>02 — 10</span>\n</div>\n</section>",
    "<section class=\"relative h-[720px] w-[1280px] overflow-hidden bg-[#F4F3EF] flex flex-col justify-between p-16\" data-slide-title=\"Dominant Color Palette\" data-slide-type=\"content\">\n<div class=\"absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:100px_100px] pointer-events-none\"></div>\n<!-- Top Navigation -->\n<div class=\"flex justify-between border-b border-black/10 pb-4\">\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-[#111111]\" style=\"font-family: 'Montserrat', sans-serif;\">02 / CHROMATIC SPECTRUM</span>\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">AUTUMN / WINTER 2026</span>\n</div>\n<!-- Asymmetric Title -->\n<div class=\"my-6\">\n<h2 class=\"text-5xl font-light text-[#111111] tracking-tight\" style=\"font-family: 'Cormorant Garamond', serif;\">\n      THE CHROMATIC DISRUPTION\n    </h2>\n<p class=\"text-[11px] tracking-[0.2em] uppercase text-neutral-500 mt-2\" style=\"font-family: 'Montserrat', sans-serif;\">\n      Monochrome baselines punctuated by raw geological elements.\n    </p>\n</div>\n<!-- Color Palette Swatch Grid -->\n<div class=\"grid grid-cols-4 gap-4 my-auto h-[320px]\">\n<!-- Color 1 -->\n<div class=\"flex flex-col justify-between p-6 bg-[#1C1C1C] text-white\">\n<div>\n<span class=\"text-xs tracking-widest block opacity-60\" style=\"font-family: 'Montserrat', sans-serif;\">CODE 01</span>\n<h3 class=\"text-xl font-light mt-1\" style=\"font-family: 'Cormorant Garamond', serif;\">OBSIDIAN</h3>\n</div>\n<div>\n<div class=\"text-[10px] tracking-widest opacity-80\" style=\"font-family: 'Montserrat', sans-serif;\">#1C1C1C</div>\n<p class=\"text-[9px] mt-2 leading-relaxed opacity-50\" style=\"font-family: 'Montserrat', sans-serif;\">\n          The deep anchor of AW26. Pure soot, light-absorbing raw matte finish.\n        </p>\n</div>\n</div>\n<!-- Color 2 -->\n<div class=\"flex flex-col justify-between p-6 bg-[#EBE9E3] text-[#111111] border border-black/10\">\n<div>\n<span class=\"text-xs tracking-widest block text-neutral-500\" style=\"font-family: 'Montserrat', sans-serif;\">CODE 02</span>\n<h3 class=\"text-xl font-light mt-1\" style=\"font-family: 'Cormorant Garamond', serif;\">BONE ASH</h3>\n</div>\n<div>\n<div class=\"text-[10px] tracking-widest text-neutral-600\" style=\"font-family: 'Montserrat', sans-serif;\">#EBE9E3</div>\n<p class=\"text-[9px] mt-2 leading-relaxed text-neutral-500\" style=\"font-family: 'Montserrat', sans-serif;\">\n          Mineral off-white. Represents unbleached raw wool, bone, limestone.\n        </p>\n</div>\n</div>\n<!-- Color 3 -->\n<div class=\"flex flex-col justify-between p-6 bg-[#4A0E17] text-white\">\n<div>\n<span class=\"text-xs tracking-widest block opacity-80\" style=\"font-family: 'Montserrat', sans-serif;\">CODE 03</span>\n<h3 class=\"text-xl font-light mt-1\" style=\"font-family: 'Cormorant Garamond', serif;\">OXBLOOD</h3>\n</div>\n<div>\n<div class=\"text-[10px] tracking-widest opacity-80\" style=\"font-family: 'Montserrat', sans-serif;\">#4A0E17</div>\n<p class=\"text-[9px] mt-2 leading-relaxed opacity-65\" style=\"font-family: 'Montserrat', sans-serif;\">\n          The violent impulse. A rich, highly saturated coagulated crimson.\n        </p>\n</div>\n</div>\n<!-- Color 4 -->\n<div class=\"flex flex-col justify-between p-6 bg-[#8D9045] text-[#111111]\">\n<div>\n<span class=\"text-xs tracking-widest block text-black/60\" style=\"font-family: 'Montserrat', sans-serif;\">CODE 04</span>\n<h3 class=\"text-xl font-light mt-1\" style=\"font-family: 'Cormorant Garamond', serif;\">ACID MOSS</h3>\n</div>\n<div>\n<div class=\"text-[10px] tracking-widest text-black/80\" style=\"font-family: 'Montserrat', sans-serif;\">#8D9045</div>\n<p class=\"text-[9px] mt-2 leading-relaxed text-black/60\" style=\"font-family: 'Montserrat', sans-serif;\">\n          An uncomfortable organic green. Evoking chemical lichen and toxicity.\n        </p>\n</div>\n</div>\n</div>\n<!-- Bottom Page Number -->\n<div class=\"flex justify-between text-[10px] tracking-[0.35em] text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">\n<span>COLOR CODES</span>\n<span>03 — 10</span>\n</div>\n</section>",
    "<section class=\"relative h-[720px] w-[1280px] overflow-hidden bg-[#F4F3EF] flex flex-col justify-between p-16\" data-slide-title=\"Fabrics and Material Trends\" data-slide-type=\"content\">\n<div class=\"absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:100px_100px] pointer-events-none\"></div>\n<!-- Top Navigation -->\n<div class=\"flex justify-between border-b border-black/10 pb-4\">\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-[#111111]\" style=\"font-family: 'Montserrat', sans-serif;\">03 / TEXTURE &amp; COMPOUND</span>\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">AW 2026 INDEX</span>\n</div>\n<!-- Main Content Layout -->\n<div class=\"grid grid-cols-12 gap-12 my-auto items-center\">\n<!-- Left Column: Fabric Description -->\n<div class=\"col-span-5 flex flex-col\">\n<h2 class=\"text-4xl font-light text-[#111111] leading-tight tracking-tight mb-6\" style=\"font-family: 'Cormorant Garamond', serif;\">\n        TACTILE HEAVINESS: THE FABRIC COMPOSITION\n      </h2>\n<p class=\"text-xs text-neutral-600 leading-relaxed mb-6\" style=\"font-family: 'Montserrat', sans-serif;\">\n        Tactile weight is elevated to psychological defense. We forecast a dramatic increase in dense materials that hold architectural form, resisting the movement of the human body.\n      </p>\n<ul class=\"space-y-3 text-xs text-[#111111] font-medium\" style=\"font-family: 'Montserrat', sans-serif;\">\n<li class=\"flex justify-between border-b border-black/10 pb-2\">\n<span class=\"tracking-wider\">01. ARCHITECTURAL FELT WOOL</span>\n<span class=\"text-[#4A0E17]\">45%</span>\n</li>\n<li class=\"flex justify-between border-b border-black/10 pb-2\">\n<span class=\"tracking-wider\">02. RECLAIMED COATED TEXTILE</span>\n<span class=\"text-[#4A0E17]\">30%</span>\n</li>\n<li class=\"flex justify-between border-b border-black/10 pb-2\">\n<span class=\"tracking-wider\">03. CRUMPLED STAINLESS STEEL RAW MESH</span>\n<span class=\"text-[#4A0E17]\">15%</span>\n</li>\n<li class=\"flex justify-between border-b border-black/10 pb-2\">\n<span class=\"tracking-wider\">04. ORGANIC FLAX FIBERS</span>\n<span class=\"text-[#4A0E17]\">10%</span>\n</li>\n</ul>\n</div>\n<!-- Right Column: Chart.js Doughnut Chart Visualizing the Tactile Composition -->\n<div class=\"col-span-7 flex flex-col items-center justify-center relative\">\n<div class=\"w-[380px] h-[380px] flex items-center justify-center bg-white/40 border border-black/5 p-6 rounded-full\">\n<canvas height=\"300\" id=\"chart-a12b3c\" width=\"300\"></canvas>\n</div>\n<!-- Center label inside doughnut -->\n<div class=\"absolute flex flex-col items-center justify-center\">\n<span class=\"text-[10px] tracking-[0.3em] uppercase text-neutral-500 font-bold\" style=\"font-family: 'Montserrat', sans-serif;\">AW26</span>\n<span class=\"text-3xl font-light text-[#111111]\" style=\"font-family: 'Cormorant Garamond', serif;\">WEIGHTS</span>\n</div>\n</div>\n</div>\n<script>\n    (() => {\n      const canvas = document.querySelector('#chart-a12b3c');\n      if (!canvas) return;\n      new Chart(canvas, {\n        type: 'doughnut',\n        data: {\n          labels: ['Felt Wool', 'Reclaimed Coated', 'Stainless Mesh', 'Organic Flax'],\n          datasets: [{\n            data: [45, 30, 15, 10],\n            backgroundColor: [\n              '#111111', // Obsidian\n              '#4A0E17', // Oxblood\n              '#8D9045', // Acid Moss\n              '#D4D1C9'  // Light Muted Gray\n            ],\n            borderWidth: 2,\n            borderColor: '#F4F3EF',\n            hoverOffset: 4\n          }]\n        },\n        options: {\n          responsive: false,\n          animation: false,\n          cutout: '80%',\n          plugins: {\n            legend: {\n              display: false\n            },\n            datalabels: {\n              display: false\n            }\n          }\n        }\n      });\n    })();\n  </script>\n<!-- Bottom Page Number -->\n<div class=\"flex justify-between text-[10px] tracking-[0.35em] text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">\n<span>TACTILE COMPOSITION</span>\n<span>04 — 10</span>\n</div>\n</section>",
    "<section class=\"relative h-[720px] w-[1280px] overflow-hidden bg-[#F4F3EF] flex flex-col justify-between p-16\" data-slide-title=\"Silhouettes and Shapes\" data-slide-type=\"content\">\n<div class=\"absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:100px_100px] pointer-events-none\"></div>\n<!-- Top Navigation -->\n<div class=\"flex justify-between border-b border-black/10 pb-4\">\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-[#111111]\" style=\"font-family: 'Montserrat', sans-serif;\">04 / FORMAL STRUCTURE</span>\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">AW 2026 GEOMETRY</span>\n</div>\n<!-- Main Grid Layout -->\n<div class=\"grid grid-cols-12 gap-12 my-auto items-center\">\n<!-- Image 1 -->\n<div class=\"col-span-4 relative flex flex-col\">\n<div class=\"h-[360px] w-full overflow-hidden grayscale contrast-110\">\n<img alt=\"Oversized sculptural coat\" class=\"w-full h-full object-cover\" image-type=\"image\" prompt=\"Fashion editorial studio, full body, avant-garde structured coat with extremely oversized architectural shoulders, minimalist high-contrast lighting\" src=\"https://presenton-public-eu.s3.eu-central-1.amazonaws.com/users/6958c0f1-63bd-4057-bf63-4421d4951284/images/56caa986-d63f-40e6-8941-08360f6e49e7.png\"/>\n</div>\n<span class=\"text-[9px] tracking-widest text-[#111111] uppercase mt-3\" style=\"font-family: 'Montserrat', sans-serif;\">FORM A / BRUTALIST SHOULDERS</span>\n</div>\n<!-- Center Narrative -->\n<div class=\"col-span-4 flex flex-col justify-center text-center px-4\">\n<h2 class=\"text-4xl font-light text-[#111111] leading-tight tracking-tight mb-6\" style=\"font-family: 'Cormorant Garamond', serif;\">\n        SILHOUETTES AS <br/><span class=\"italic text-[#4A0E17]\">ARCHITECTURE</span>\n</h2>\n<p class=\"text-xs text-neutral-600 leading-relaxed\" style=\"font-family: 'Montserrat', sans-serif;\">\n        The human contour is replaced by angular geometries. Shoulders extend outward in brutalist, horizontal axes, contrasting with violently cinched, protective midsections. No softness, purely constructed physical defense.\n      </p>\n<div class=\"w-16 h-[0.5px] bg-[#111111] mx-auto my-6\"></div>\n<p class=\"text-[10px] tracking-[0.3em] uppercase text-[#111111] font-semibold\" style=\"font-family: 'Montserrat', sans-serif;\">\n        VOLUME OVER MOVEMENT\n      </p>\n</div>\n<!-- Image 2 -->\n<div class=\"col-span-4 relative flex flex-col\">\n<div class=\"h-[360px] w-full overflow-hidden grayscale contrast-110\">\n<img alt=\"Avant-garde high-collared garment\" class=\"w-full h-full object-cover\" image-type=\"image\" prompt=\"High-fashion editorial photo, abstract sculpture of high-collared structured cocoon clothing covering the face of model, extremely minimal and avant-garde, warm white and deep black\" src=\"https://presenton-public-eu.s3.eu-central-1.amazonaws.com/users/6958c0f1-63bd-4057-bf63-4421d4951284/images/f3b8aef4-65e3-45f7-be9f-f1bed84b8f41.png\"/>\n</div>\n<span class=\"text-[9px] tracking-widest text-[#111111] uppercase mt-3\" style=\"font-family: 'Montserrat', sans-serif;\">FORM B / COCOON PROTECTOR</span>\n</div>\n</div>\n<!-- Bottom Page Number -->\n<div class=\"flex justify-between text-[10px] tracking-[0.35em] text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">\n<span>SILHOUETTES &amp; SHAPES</span>\n<span>05 — 10</span>\n</div>\n</section>",
    "<section class=\"relative h-[720px] w-[1280px] overflow-hidden bg-[#121212] flex flex-col justify-between p-16 text-white\" data-slide-title=\"Streetwear Influence\" data-slide-type=\"content\">\n<!-- Subtle dark grid -->\n<div class=\"absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.01)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.01)_1px,transparent_1px)] bg-[size:100px_100px] pointer-events-none\"></div>\n<!-- Top Navigation -->\n<div class=\"flex justify-between border-b border-white/10 pb-4\">\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-white\" style=\"font-family: 'Montserrat', sans-serif;\">05 / SUBVERSION &amp; STREET</span>\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-neutral-500\" style=\"font-family: 'Montserrat', sans-serif;\">AW 2026 DISRUPTOR</span>\n</div>\n<!-- Main Content Layout -->\n<div class=\"grid grid-cols-12 gap-8 my-auto items-center\">\n<!-- Left Column: Heavy textual statement -->\n<div class=\"col-span-5 flex flex-col justify-center\">\n<span class=\"text-[10px] tracking-[0.3em] uppercase text-[#8D9045] font-semibold mb-4\" style=\"font-family: 'Montserrat', sans-serif;\">\n        THE NEW UTILITY PROTOCOL\n      </span>\n<h2 class=\"text-5xl font-light leading-tight tracking-tight mb-6 text-white\" style=\"font-family: 'Cormorant Garamond', serif;\">\n        STREETWEAR BECOMES <br/><span class=\"italic text-neutral-400 font-normal\">TECHNICAL UTILITY</span>\n</h2>\n<p class=\"text-xs text-neutral-400 leading-relaxed mb-8\" style=\"font-family: 'Montserrat', sans-serif;\">\n        The graphic era of street fashion has collapsed. In its place: heavy-gauge modular vests, extreme weatherproofing, and architectural sportswear meant for survivalism. No logos, just absolute function.\n      </p>\n<div class=\"flex items-center space-x-4\">\n<div class=\"px-3 py-1 bg-white/5 border border-white/10 text-[9px] tracking-widest uppercase text-white\" style=\"font-family: 'Montserrat', sans-serif;\">\n          WATER-REPELLENT MEMBRANE\n        </div>\n<div class=\"px-3 py-1 bg-white/5 border border-white/10 text-[9px] tracking-widest uppercase text-white\" style=\"font-family: 'Montserrat', sans-serif;\">\n          MODULAR POCKET SYSTEMS\n        </div>\n</div>\n</div>\n<!-- Right Column: Editorial Visual -->\n<div class=\"col-span-7 relative h-[420px] w-full overflow-hidden grayscale border border-white/10\">\n<img alt=\"Technical brutalist streetwear AW26\" class=\"w-full h-full object-cover\" image-type=\"image\" prompt=\"Atmospheric high-fashion street model wearing technical brutalist raincoat with high utility pockets and tactical straps, urban minimal dark concrete environment\" src=\"https://presenton-public-eu.s3.eu-central-1.amazonaws.com/users/6958c0f1-63bd-4057-bf63-4421d4951284/images/ab60ff46-f08d-4f19-b219-9630cb27a225.png\"/>\n<div class=\"absolute top-4 right-4 bg-black/60 backdrop-blur-md px-3 py-1.5 border border-white/20\">\n<span class=\"text-[9px] tracking-widest text-[#8D9045]\" style=\"font-family: 'Montserrat', sans-serif;\">AW26 / SHIFTED UTILITY</span>\n</div>\n</div>\n</div>\n<!-- Bottom Page Number -->\n<div class=\"flex justify-between text-[10px] tracking-[0.35em] text-neutral-500\" style=\"font-family: 'Montserrat', sans-serif;\">\n<span>UTILITY CODES</span>\n<span>06 — 10</span>\n</div>\n</section>",
    "<section class=\"relative h-[720px] w-[1280px] overflow-hidden bg-[#F4F3EF] flex flex-col justify-between p-16\" data-slide-title=\"Luxury and Craftsmanship\" data-slide-type=\"content\">\n<div class=\"absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:100px_100px] pointer-events-none\"></div>\n<!-- Top Navigation -->\n<div class=\"flex justify-between border-b border-black/10 pb-4\">\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-[#111111]\" style=\"font-family: 'Montserrat', sans-serif;\">06 / THE MANUAL TRADITION</span>\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">AW 2026 METICULOUSNESS</span>\n</div>\n<!-- Layout: Huge visual with overlaying craft metrics -->\n<div class=\"grid grid-cols-12 gap-12 my-auto items-center\">\n<!-- Left Visual Column (Macro Craft Detail) -->\n<div class=\"col-span-6 relative\">\n<div class=\"h-[400px] w-full overflow-hidden grayscale border border-black/10\">\n<img alt=\"Hand-stitching leather detail\" class=\"w-full h-full object-cover\" image-type=\"image\" prompt=\"Macro photographic focus of expert hands hand-stitching raw leather with strong visible wax thread, delicate craft workshop, high fashion atelier detail\" src=\"https://presenton-public-eu.s3.eu-central-1.amazonaws.com/users/6958c0f1-63bd-4057-bf63-4421d4951284/images/6ecbdb43-7259-4c5c-8977-29b12cd0d084.png\"/>\n</div>\n<div class=\"absolute bottom-4 left-4 bg-white/90 px-3 py-1 text-[9px] tracking-widest text-[#111111]\" style=\"font-family: 'Montserrat', sans-serif;\">\n        ATELIER STUDY / PARIS, FR.\n      </div>\n</div>\n<!-- Right Narrative & Metric Column -->\n<div class=\"col-span-6 flex flex-col\">\n<span class=\"text-[10px] tracking-[0.3em] uppercase text-[#4A0E17] font-semibold mb-4\" style=\"font-family: 'Montserrat', sans-serif;\">\n        THE REJECTION OF AUTOMATION\n      </span>\n<h2 class=\"text-4xl font-light text-[#111111] leading-tight tracking-tight mb-6\" style=\"font-family: 'Cormorant Garamond', serif;\">\n        CRAFT AS REBELLION: <br/>THE HAUTE ATELIER\n      </h2>\n<p class=\"text-xs text-neutral-600 leading-relaxed mb-8\" style=\"font-family: 'Montserrat', sans-serif;\">\n        Luxury is redefined not by rarity of material, but by the physical compression of time. Hand-burnished raw metals, exposed structural stitching, and intentionally raw edges display the violent presence of the human hand over computational perfection.\n      </p>\n<!-- Metric Highlights -->\n<div class=\"grid grid-cols-2 gap-8 border-t border-black/10 pt-6\">\n<div>\n<span class=\"text-3xl font-light text-[#111111]\" style=\"font-family: 'Cormorant Garamond', serif;\">120+ Hrs</span>\n<p class=\"text-[10px] tracking-widest text-neutral-500 uppercase mt-1\" style=\"font-family: 'Montserrat', sans-serif;\">REQUIRED PER GARMENT</p>\n</div>\n<div>\n<span class=\"text-3xl font-light text-[#4A0E17]\" style=\"font-family: 'Cormorant Garamond', serif;\">100%</span>\n<p class=\"text-[10px] tracking-widest text-neutral-500 uppercase mt-1\" style=\"font-family: 'Montserrat', sans-serif;\">TRACEABLE ARTISANAL GUILDS</p>\n</div>\n</div>\n</div>\n</div>\n<!-- Bottom Page Number -->\n<div class=\"flex justify-between text-[10px] tracking-[0.35em] text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">\n<span>ATELIER METRICS</span>\n<span>07 — 10</span>\n</div>\n</section>",
    "<section class=\"relative h-[720px] w-[1280px] overflow-hidden bg-[#F4F3EF] flex flex-col justify-between p-16\" data-slide-title=\"Sustainability\" data-slide-type=\"content\">\n<div class=\"absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:100px_100px] pointer-events-none\"></div>\n<!-- Top Navigation -->\n<div class=\"flex justify-between border-b border-black/10 pb-4\">\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-[#111111]\" style=\"font-family: 'Montserrat', sans-serif;\">07 / ECOLOGICAL INTEGRITY</span>\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">AW 2026 REGENERATION</span>\n</div>\n<!-- Content Split with elegant Minimal Chart -->\n<div class=\"grid grid-cols-12 gap-12 my-auto items-center\">\n<!-- Left narrative and details -->\n<div class=\"col-span-6 flex flex-col\">\n<span class=\"text-[10px] tracking-[0.3em] uppercase text-[#8D9045] font-semibold mb-4\" style=\"font-family: 'Montserrat', sans-serif;\">\n        REGENERATIVE FIBER METRICS\n      </span>\n<h2 class=\"text-4xl font-light text-[#111111] leading-tight tracking-tight mb-6\" style=\"font-family: 'Cormorant Garamond', serif;\">\n        CIRCULAR RE-INJECTION\n      </h2>\n<p class=\"text-xs text-neutral-600 leading-relaxed mb-8\" style=\"font-family: 'Montserrat', sans-serif;\">\n        By AW 2026, premium garments require fully documented lifecycle circularity. We observe structural investment shifting heavily into low-impact local dyeing practices and pre-consumer post-wool textile recycling loops.\n      </p>\n<!-- Key Callouts -->\n<div class=\"flex space-x-12\">\n<div>\n<span class=\"text-xs font-semibold text-neutral-400 block tracking-widest uppercase mb-1\" style=\"font-family: 'Montserrat', sans-serif;\">AW24 BASELINE</span>\n<span class=\"text-2xl font-light text-neutral-400\" style=\"font-family: 'Cormorant Garamond', serif;\">38% CIRCULAR</span>\n</div>\n<div>\n<span class=\"text-xs font-semibold text-[#8D9045] block tracking-widest uppercase mb-1\" style=\"font-family: 'Montserrat', sans-serif;\">AW26 FORECAST</span>\n<span class=\"text-2xl font-light text-[#111111]\" style=\"font-family: 'Cormorant Garamond', serif;\">74% CIRCULAR</span>\n</div>\n</div>\n</div>\n<!-- Right Elegant Chart.js Bar Chart -->\n<div class=\"col-span-6 flex flex-col justify-center items-end\">\n<div class=\"bg-white/40 border border-black/5 p-8 w-[450px]\">\n<h3 class=\"text-xs tracking-widest text-[#111111] uppercase font-semibold mb-6 text-right\" style=\"font-family: 'Montserrat', sans-serif;\">\n          ADOPTION OF CIRCULAR FIBERS BY SEGMENT (%)\n        </h3>\n<!-- Chart Canvas -->\n<canvas height=\"200\" id=\"chart-d4e5f6\" width=\"380\"></canvas>\n</div>\n</div>\n</div>\n<script>\n    (() => {\n      const canvas = document.querySelector('#chart-d4e5f6');\n      if (!canvas) return;\n      new Chart(canvas, {\n        type: 'bar',\n        data: {\n          labels: ['Outerwear', 'Tailoring', 'Knitwear', 'Accessories'],\n          datasets: [\n            {\n              label: 'AW24 Baseline',\n              data: [35, 20, 50, 15],\n              backgroundColor: '#D4D1C9',\n              barPercentage: 0.6,\n              categoryPercentage: 0.8\n            },\n            {\n              label: 'AW26 Target',\n              data: [82, 60, 95, 55],\n              backgroundColor: '#8D9045',\n              barPercentage: 0.6,\n              categoryPercentage: 0.8\n            }\n          ]\n        },\n        options: {\n          responsive: false,\n          animation: false,\n          plugins: {\n            legend: {\n              display: false\n            },\n            datalabels: {\n              anchor: 'end',\n              align: 'end',\n              color: '#111111',\n              font: {\n                family: 'Montserrat',\n                size: 9,\n                weight: 'bold'\n              },\n              formatter: function(value) { return value + '%'; }\n            }\n          },\n          scales: {\n            x: {\n              grid: { display: false },\n              ticks: {\n                color: '#111111',\n                font: { family: 'Montserrat', size: 9, weight: 'bold' }\n              }\n            },\n            y: {\n              display: false,\n              grid: { display: false }\n            }\n          }\n        }\n      });\n    })();\n  </script>\n<!-- Bottom Page Number -->\n<div class=\"flex justify-between text-[10px] tracking-[0.35em] text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">\n<span>CIRCULAR METRICS</span>\n<span>08 — 10</span>\n</div>\n</section>",
    "<section class=\"relative h-[720px] w-[1280px] overflow-hidden bg-[#F4F3EF] flex flex-col justify-between p-16\" data-slide-title=\"Complete Visual Mood Board\" data-slide-type=\"content\">\n<div class=\"absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:100px_100px] pointer-events-none\"></div>\n<!-- Top Navigation -->\n<div class=\"flex justify-between border-b border-black/10 pb-4\">\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-[#111111]\" style=\"font-family: 'Montserrat', sans-serif;\">08 / ATMOSPHERIC COMPILATION</span>\n<span class=\"text-[10px] tracking-[0.4em] uppercase text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">AW 2026 SYSTEM</span>\n</div>\n<!-- Asymmetric Editorial Grid Mood Board -->\n<div class=\"grid grid-cols-12 gap-4 my-auto h-[400px]\">\n<!-- Panel 1: Main Editorial Figure (Tall) -->\n<div class=\"col-span-4 relative overflow-hidden grayscale contrast-[1.05] border border-black/5\">\n<img alt=\"Layered heavy trenchcoat\" class=\"w-full h-full object-cover\" image-type=\"image\" prompt=\"Editorial fashion profile, model in raw structure gray winter trenchcoat with heavy wool layers, minimal abstract architecture, soft studio shadow\" src=\"https://presenton-public-eu.s3.eu-central-1.amazonaws.com/users/6958c0f1-63bd-4057-bf63-4421d4951284/images/9b2c3303-b84d-4613-83d5-7b16e4825d5a.png\"/>\n<span class=\"absolute bottom-3 left-3 text-[8px] tracking-widest text-white mix-blend-difference\" style=\"font-family: 'Montserrat', sans-serif;\">FIG. 01 / FORM OVER SURFACE</span>\n</div>\n<!-- Panel 2: Color Block with text overlay -->\n<div class=\"col-span-3 bg-[#4A0E17] flex flex-col justify-between p-6 text-white\">\n<div>\n<span class=\"text-[9px] tracking-widest uppercase opacity-80\" style=\"font-family: 'Montserrat', sans-serif;\">CHROME ACCENT</span>\n<h3 class=\"text-3xl font-light leading-tight mt-4\" style=\"font-family: 'Cormorant Garamond', serif;\">\n          The Deep <br/><span class=\"italic text-[#EBE9E3]\">Visceral</span> <br/>Response.\n        </h3>\n</div>\n<p class=\"text-[9px] tracking-widest opacity-60 uppercase\" style=\"font-family: 'Montserrat', sans-serif;\">OXBLOOD SHIFT</p>\n</div>\n<!-- Panel 3: Abstract texture crop (Metallic/Technical) -->\n<div class=\"col-span-5 grid grid-rows-2 gap-4\">\n<div class=\"relative overflow-hidden grayscale border border-black/5\">\n<img alt=\"Metallic raw craft swatch\" class=\"w-full h-full object-cover\" image-type=\"image\" prompt=\"Macro industrial high fashion texture, crumpled silver metallic cloth meets heavy thick dark wool felt fabric, studio lighting detail\" src=\"https://presenton-public-eu.s3.eu-central-1.amazonaws.com/users/6958c0f1-63bd-4057-bf63-4421d4951284/images/3cf33b30-4c2a-4f18-9438-518ea82ae4c3.png\"/>\n<span class=\"absolute bottom-2 left-3 text-[8px] tracking-widest text-white mix-blend-difference\" style=\"font-family: 'Montserrat', sans-serif;\">FIG. 02 / HYBRIDIZATION</span>\n</div>\n<div class=\"relative overflow-hidden border border-black/5\">\n<img alt=\"Acid Moss textured styling\" class=\"w-full h-full object-cover\" image-type=\"image\" prompt=\"Avant-garde high fashion studio detail shot, model wearing deep textured moss green structural scarf, raw fiber focus, moody atmospheric light\" src=\"https://presenton-public-eu.s3.eu-central-1.amazonaws.com/users/6958c0f1-63bd-4057-bf63-4421d4951284/images/93233737-0e0a-4f4f-a8f5-3c3a08aba141.png\"/>\n<span class=\"absolute bottom-2 left-3 text-[8px] tracking-widest text-white mix-blend-difference\" style=\"font-family: 'Montserrat', sans-serif;\">FIG. 03 / LICHEN &amp; STRUCTURE</span>\n</div>\n</div>\n</div>\n<!-- Bottom Page Number -->\n<div class=\"flex justify-between text-[10px] tracking-[0.35em] text-neutral-400\" style=\"font-family: 'Montserrat', sans-serif;\">\n<span>VISUAL COMPILATION</span>\n<span>09 — 10</span>\n</div>\n</section>",
    "<section class=\"relative h-[720px] w-[1280px] overflow-hidden bg-[#111111] flex flex-col justify-between p-16 text-white select-none\" data-slide-title=\"Closing Statement\" data-slide-type=\"closing\">\n  <!-- Editorial Background Image with Overlay for Readability -->\n  <div class=\"absolute inset-0 z-0\">\n    <img src=\"https://presenton-public-eu.s3.eu-central-1.amazonaws.com/users/6958c0f1-63bd-4057-bf63-4421d4951284/images/244bdc75-0dc9-4d62-b333-ea6c7c0ad8cd.png\" class=\"w-full h-full object-cover opacity-40 grayscale\" alt=\"Textured wool fabric\" image-type=\"image\">\n    <div class=\"absolute inset-0 bg-gradient-to-t from-[#111111] via-transparent to-[#111111] opacity-80\"></div>\n  </div>\n\n  <!-- Subtle background texture of grid -->\n  <div class=\"absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:100px_100px] pointer-events-none z-10\"></div>\n\n  <!-- Top Metadata -->\n  <div class=\"flex justify-between border-b border-white/20 pb-6 z-20 relative\">\n    <div class=\"flex flex-col gap-1\">\n      <span class=\"text-[10px] tracking-[0.5em] uppercase text-neutral-400 font-semibold\" style=\"font-family: 'Montserrat', sans-serif;\">EPILOGUE</span>\n      <span class=\"text-[9px] tracking-[0.3em] uppercase text-neutral-500\" style=\"font-family: 'Montserrat', sans-serif;\">ARCHIVE REF: AW26-FIN</span>\n    </div>\n    <span class=\"text-[10px] tracking-[0.4em] uppercase text-[#8D9045] font-medium\" style=\"font-family: 'Montserrat', sans-serif;\">AW 2026 / 2027</span>\n  </div>\n\n  <!-- Centered Heavy Serif Closing Statement -->\n  <div class=\"my-auto z-20 relative max-w-4xl mx-auto text-center flex flex-col items-center\">\n    <div class=\"w-16 h-[1px] bg-[#4A0E17] mb-12 shadow-[0_0_15px_rgba(74,14,23,0.8)]\"></div>\n    <h2 class=\"text-6xl leading-[1.1] font-light tracking-tight text-white\" style=\"font-family: 'Cormorant Garamond', serif;\">\n      “THE NEXT SEASON IS <span class=\"italic text-neutral-400\">QUIETER,</span><br/>\n      <span class=\"italic text-[#4A0E17] font-normal drop-shadow-sm\">SHARPER,</span> AND MORE HUMAN.”\n    </h2>\n    <div class=\"mt-10 h-px w-8 bg-white/20\"></div>\n    <p class=\"mt-10 text-[11px] tracking-[0.5em] uppercase text-neutral-400 max-w-md leading-loose font-light\" style=\"font-family: 'Montserrat', sans-serif;\">\n      THE END OF COGNITIVE NOISE.<br/>THE RETURN TO TACTILE TRUTH.\n    </p>\n  </div>\n\n  <!-- Bottom Metadata -->\n  <div class=\"flex justify-between items-end text-[10px] tracking-[0.4em] text-neutral-500 z-20 relative\" style=\"font-family: 'Montserrat', sans-serif;\">\n    <div class=\"flex flex-col gap-1\">\n      <span class=\"text-neutral-600\">PREDICTION ANALYSIS</span>\n      <span>FASHION FORECAST REPORT</span>\n    </div>\n    <div class=\"text-right\">\n      <span class=\"text-white font-medium\">10 — 10</span>\n    </div>\n  </div>\n</section>"
